{
  "name": "template-cdk",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "cdk": "node --env-file-if-exists=.env node_modules/aws-cdk/bin/cdk",
    "ensure-bootstrap": "node --env-file-if-exists=.env --import tsx tools/ensure-bootstrap.ts",
    "deploy:dev": "npm run ensure-bootstrap -- dev && npm run cdk -- deploy -c stage=dev",
    "deploy:staging": "npm run cdk -- deploy -c stage=staging",
    "deploy:uat": "npm run cdk -- deploy -c stage=uat",
    "deploy:prod": "npm run cdk -- deploy -c stage=prod",
    "deploy:dev:hotswap": "npm run ensure-bootstrap -- dev && npm run cdk -- deploy -c stage=dev --hotswap",
    "watch:dev": "npm run ensure-bootstrap -- dev && npm run cdk -- watch -c stage=dev",
    "diff:dev": "npm run cdk -- diff -c stage=dev",
    "diff:staging": "npm run cdk -- diff -c stage=staging",
    "diff:uat": "npm run cdk -- diff -c stage=uat",
    "diff:prod": "npm run cdk -- diff -c stage=prod",
    "synth:dev": "npm run cdk -- synth -c stage=dev",
    "destroy:dev": "npm run cdk -- destroy -c stage=dev",
    "deploy:personal": "npm run ensure-bootstrap -- dev && npm run cdk -- deploy -c stage=dev -c personal=true",
    "watch:personal": "npm run ensure-bootstrap -- dev && npm run cdk -- watch -c stage=dev -c personal=true",
    "destroy:personal": "npm run cdk -- destroy -c stage=dev -c personal=true",
    "bootstrap": "npm run cdk -- bootstrap",
    "local": "node --env-file-if-exists=.env --import ./tools/middy-hook.mjs --import tsx",
    "openapi": "node --import ./tools/middy-hook.mjs --import tsx tools/generate-openapi.ts",
    "openapi:check": "node --import ./tools/middy-hook.mjs --import tsx tools/generate-openapi.ts --check",
    "typecheck": "tsc",
    "test": "node --import ./tools/middy-hook.mjs --import tsx --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "keywords": [
    "aws",
    "cdk",
    "lambda",
    "template"
  ],
  "author": "Eugene Mahota",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1154.0",
    "@aws-sdk/client-sfn": "^3.1154.0",
    "@aws-sdk/client-sns": "^3.1154.0",
    "@aws-sdk/client-sqs": "^3.1154.0",
    "@aws-sdk/lib-dynamodb": "^3.1154.0",
    "@middy/core": "^7.9.2",
    "@middy/http-cors": "^7.9.2",
    "@middy/http-error-handler": "^7.9.2",
    "@middy/http-json-body-parser": "^7.9.2",
    "@middy/http-response-serializer": "^7.9.2",
    "aws-cdk-lib": "^2.274.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "^10.8.1",
    "joi": "^18.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1158.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1146.0",
    "esbuild": "^0.28.2",
    "joi-to-json": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "yaml": "^2.9.1"
  }
}
