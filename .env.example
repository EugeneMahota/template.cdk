# Copy to .env and fill in your values. The deploy, diff, synth, destroy and bootstrap scripts take AWS_PROFILE
# from here; an AWS_PROFILE exported in the shell wins over this file. CI has no .env and uses its OIDC role
AWS_PROFILE=<your profile>
# Your personal environment for the *:personal scripts: up to 20 lowercase letters, digits and dashes
OWNER=<your name>

# For local runs (npm run local -- <handler file>)
AWS_REGION=eu-west-1
STAGE=dev

# Resources of the deployed dev stage. <account-id> is your AWS account id
LOGS_TABLE=template-cdk-logs-dev
LOGS_TABLE_CODE_INDEX=eventCode-createdAt-index
LOGS_TOPIC_ARN=arn:aws:sns:eu-west-1:<account-id>:template-cdk-logs-topic-dev
QUEUE_EXAMPLE_URL=https://sqs.eu-west-1.amazonaws.com/<account-id>/template-cdk-queue-example-dev
DELAYED_EXECUTION_STATEMACHINE_ARN=arn:aws:states:eu-west-1:<account-id>:stateMachine:template-cdk-delayed-execution-dev
